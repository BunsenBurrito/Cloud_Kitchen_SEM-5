# Copy this file to ".env" and fill in the values.
PORT=5000
NODE_ENV=development

# SQL database
DB_DIALECT=mysql
DB_HOST=mysql-28f6e0f5-varunghegade06-a726.h.aivencloud.com
DB_PORT=22888
DB_NAME=cloud_kitchen
DB_USER=<username>
DB_PASSWORD=<password>
DB_SQLITE_FILE=./cloud_kitchen.sqlite
# Aiven (and most cloud MySQL) only accept SSL connections. Set to false for a local MySQL server.
DB_SSL=true
# Optional: path to the CA certificate downloaded from the provider, to also verify the server
DB_SSL_CA=

JWT_SECRET=jwt_secret
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (the Vite dev server runs on port 3000, see frontend/vite.config.js)
CLIENT_URL=http://localhost:3000

# Used only by `npm run seed` to create the first admin account
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@cloudkitchen.com
SEED_ADMIN_PASSWORD=Admin@12345

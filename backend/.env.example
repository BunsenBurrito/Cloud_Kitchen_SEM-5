# Copy this file to ".env" and fill in the values.
PORT=5000
NODE_ENV=development

# ---- SQL database (default: MySQL) ----
DB_DIALECT=mysql          # mysql | postgres (npm i pg pg-hstore) | sqlite (npm i sqlite3)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cloud_kitchen     # created automatically for MySQL if it does not exist
DB_USER=root
DB_PASSWORD=
DB_SQLITE_FILE=./cloud_kitchen.sqlite   # only used when DB_DIALECT=sqlite

# Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (the Vite dev server runs on port 3000, see frontend/vite.config.js)
CLIENT_URL=http://localhost:3000

# Used only by `npm run seed` to create the first admin account
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@cloudkitchen.com
SEED_ADMIN_PASSWORD=Admin@12345
